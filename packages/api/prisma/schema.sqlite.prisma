// =============================================================================
// Samou' Go — LOCAL DEV schema (SQLite). DO NOT use for production.
// -----------------------------------------------------------------------------
// This is the local-development variant. Production deploys against
// `schema.prisma` (PostgreSQL) and runs `prisma migrate deploy`. This file
// mirrors every model but keeps the SQLite-compatible datasource and strips the
// Postgres native types (@db.*). Keep both files in sync when a model changes.
//
// Hyper-local delivery for Samou', Hebron, Palestine.
//
// Two deliberate constraints shape this model:
//   1. Customer destinations are FREE TEXT. Samou' has no reliable street
//      numbering, so orders carry `customerAddressText` (neighbourhood /
//      landmark) and the captain phones the customer. GPS exists only on the
//      operational side: `Store.latitude/longitude` pin the shop and the
//      `CaptainLocation` model streams the assigned captain's live position
//      for order tracking — never on the customer address.
//   2. Money is Decimal(10,2), never Float. Prisma returns Decimal objects;
//      `src/modules/**/**.mapper.ts` converts them to numbers at the edge.
//
// Enum string values MUST stay byte-identical to packages/shared-types/src/enums.ts
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // Independent output so SQLite codegen never overwrites the PostgreSQL client
  // (which is generated into `../generated/prisma-postgres`).
  output = "../generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  CUSTOMER
  STORE_MANAGER
  CAPTAIN
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

/// Samou' is a cash economy; COD is the only live method.
/// Declared as an enum so adding card/wallet later is a migration, not a refactor.
enum PaymentMethod {
  COD
}

/// How a voucher's `discountValue` is interpreted.
enum VoucherDiscountType {
  PERCENT
  FIXED
}

enum TicketStatus {
  OPEN
  RESOLVED
}
enum SettlementMethod {
  CASH
  BANK_TRANSFER
}
enum LedgerEntryType {
  COMMISSION
  EARNING
  SETTLEMENT
  ADJUSTMENT
}

/// Lifecycle of a customer's custom request — ask, price, accept/reject.
enum CustomRequestStatus {
  PENDING
  PRICE_OFFERED
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Three-state store availability toggle.
enum StoreStatus {
  OPEN
  BUSY
  CLOSED
}

// =============================================================================
// Models
// =============================================================================

/// One account, one role. Phone is the login identifier — Samou' users do not
/// reliably have email.
model User {
  id           String   @id @default(cuid())
  name         String  
  /// Canonical Palestinian mobile: 10 digits, `05XXXXXXXX`.
  phone        String   @unique
  /// bcrypt hash. Never selected into an API response.
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  /// CAPTAIN accounts must be confirmed by an admin before they can take jobs.
  isVerified   Boolean  @default(false)
  /// CAPTAIN self-managed availability — must be on to claim orders.
  isAvailable  Boolean  @default(false)
  assignedStoreId String?
  /// Processed avatar URL served by the uploads pipeline (webp, immutable-cached).
  profileImageUrl String?
  /// Storage key of the avatar object (never exposed over the API).
  profileImageKey String?
  /// Customer's own location, shared via the browser geolocation flow —
  /// informational today, the seed for future zone geofencing.
  latitude  Float?
  longitude Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedStores  Store[]              @relation("StoreManager")
  customerOrders Order[]              @relation("OrderCustomer")
  captainOrders  Order[]              @relation("OrderCaptain")
  statusChanges  OrderStatusHistory[] @relation("StatusChangedBy")
  refreshTokens  RefreshToken[]
  favorites      Favorite[]           @relation("UserFavorites")
  assignedStore  Store?               @relation("DedicatedStoreCaptain", fields: [assignedStoreId], references: [id], onDelete: SetNull)
  captainLocation CaptainLocation?
  customRequests CustomRequest[]      @relation("CustomRequestCustomer")
  ratingsGiven Rating[] @relation("RatingCustomer")
  ratingsAsCaptain Rating[] @relation("RatingCaptain")
  chatMessages ChatMessage[]
  supportTickets SupportTicket[]
  wallet Wallet?
  ledgerEntries LedgerEntry[]
  deviceTokens  DeviceToken[]


  @@index([role, isActive])
  @@index([assignedStoreId])
  @@map("users")
}

/// One active OTP per phone number (keyed by `phone`).
/// The code is bcrypt-hashed at rest and auto-expires in 3 minutes.
/// `requests`/`windowStartsAt` back the 3-per-5-minute request limiter so it
/// survives server restarts and does not depend on a single-node memory store.
model OtpRequest {
  phone          String   @id
  /// bcrypt hash of the 6-digit code. Never store the plaintext.
  codeHash       String
  expiresAt      DateTime
  /// Successful `code` attempts — wrong codes can only be tried a few times
  /// before the code is invalidated.
  attempts       Int      @default(0)
  /// OTP dispatch count inside the current rate-limit window.
  requests       Int      @default(1)
  /// Start of the 5-minute rate-limit window.
  windowStartsAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("otp_requests")
}

/// Long-lived session credential. Only the SHA-256 of the token is stored.
/// Refresh tokens rotate on use; an old token is revoked the moment its
/// replacement is minted, so replay of a stolen token fails.
model RefreshToken {
  id             String    @id @default(cuid())
  /// SHA-256 hex of the raw token. Never store the raw token.
  tokenHash      String    @unique
  userId         String
  expiresAt      DateTime
  /// Set when the token has been rotated or revoked.
  revokedAt      DateTime?
  /// The token that replaced this one (rotation lineage).
  replacedByHash String?   @unique
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// A shop in Samou'. `managerId` is the STORE_MANAGER who runs it; one manager
/// may run several shops.
model Store {
  id         String   @id @default(cuid())
  nameAr     String  
  nameEn     String  
  logoUrl    String?
  /// Wide hero image behind the store header — processed by the uploads
  /// pipeline (`store` kind, `cover` purpose).
  coverUrl   String?
  phone      String  
  isActive   Boolean  @default(true)
  /// New stores stay hidden from the public catalogue until an admin approves.
  isApproved Boolean  @default(false)
  /// Admin-curated: surfaces a "Recommended by us" badge on customer screens.
  isRecommended Boolean @default(false)
  /// Instant toggle: when false, customers see "closed" but the store stays
  /// visible in the catalogue. Manager flips this without touching `isActive`.
  isAcceptingOrders Boolean @default(true)
  /// Three-state availability: OPEN = accepting, BUSY = prep delay, CLOSED = not accepting.
  storeStatus StoreStatus @default(OPEN)
  /// Store operating hours (HH:mm format, e.g. "08:00", "23:00").
  openingTime String?
  closingTime String?
  managerId  String
  /// Shopfront GPS, when known — powers the captain's "navigate to store".
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  manager    User       @relation("StoreManager", fields: [managerId], references: [id], onDelete: Restrict)
  categories Category[]
  products   Product[]
  orders     Order[]
  offers     Offer[]
  favorites  Favorite[] @relation("StoreFavorites")
  dedicatedCaptains User[] @relation("DedicatedStoreCaptain")
  ratings Rating[]
  wallet Wallet?
  customRequests CustomRequest[]

  @@index([managerId])
  @@index([isActive])
  @@index([nameAr])
  @@map("stores")
}

/// A menu section, scoped to one store. Two stores may both have "مشروبات".
model Category {
  id        String   @id @default(cuid())
  nameAr    String  
  nameEn    String  
  imageUrl  String?
  storeId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, nameEn])
  @@index([storeId, sortOrder])
  @@map("categories")
}

/// A sellable item. `price` is the *current* price; an order captures its own
/// `unitPrice` so repricing never rewrites history.
model Product {
  id          String   @id @default(cuid())
  nameAr      String  
  description String? 
  price       Decimal 
  imageUrl    String?
  isAvailable Boolean  @default(true)
  categoryId  String?
  storeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  offerProducts OfferProduct[]

  @@index([storeId, isAvailable])
  @@index([categoryId])
  @@index([nameAr])
  @@map("products")
}

/// A basket that has been committed. Financials are written by the server only —
/// `deliveryFee` always comes from `calculateDeliveryFee(itemCount)` in
/// @samou-go/shared-types, never from the client.
model Order {
  id          String @id @default(cuid())
  /// Human-facing reference shown to the customer: `SG-260728-0042`.
  orderNumber String @unique

  customerId String
  storeId    String
  /// Null until an admin or the captain themselves takes the job.
  captainId  String?
  /// Links sub-orders from a multi-store cart checkout.
  cartCheckoutId String?

  status OrderStatus @default(PENDING)

  /// Free-text destination: neighbourhood, street, landmark. No GPS by design.
  customerAddressText String 
  /// Optional extra directions, e.g. "بجانب مسجد عمر، الطابق الثاني".
  addressNote         String?
  /// Customer instruction for the whole order (e.g. delivery presets + freeform).
  orderNote           String?
  /// Customer delivery preset, e.g. "call_on_arrival" or "leave_at_door".
  deliveryPreset      String?
  /// Exact GPS coordinates of the delivery pin — nullable for legacy orders.
  latitude            Float?
  longitude           Float?
  estimatedPrepMinutes Int?

  /// 4-digit PIN the customer shares with the captain on delivery.
  deliveryPin String?
  /// Failed PIN validation attempts — locked after 5.
  deliveryPinAttempts Int @default(0)

  subtotal      Decimal      
  deliveryFee   Decimal      
  /// Voucher savings, in ILS — 0 when no voucher was applied.
  discount      Decimal       @default(0)
  totalAmount   Decimal      
  paymentMethod PaymentMethod @default(COD)
  voucherId     String?
  /// Fee zone chosen by the assigned captain — fee is derived from it server-side.
  deliveryZoneId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User                 @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  store         Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  captain       User?                @relation("OrderCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  voucher       Voucher?             @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  deliveryZone  DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  rating Rating?
  chatMessages ChatMessage[]

  @@index([customerId, createdAt])
  @@index([storeId, status])
  @@index([captainId, status])
  @@index([status, createdAt])
  @@index([deliveryZoneId])
  @@index([cartCheckoutId])
  @@map("orders")
}

/// One basket line. `unitPrice` and `totalPrice` are frozen at order time.
model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal
  note       String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// One row per product per order — quantity carries the count.
  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

/// Append-only audit trail. This is what the Live Order Tracking screen renders
/// as a timeline, and what settles "who cancelled my order?" disputes.
model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  /// Null for system-driven transitions (e.g. auto-expiry jobs).
  changedByUserId String?
  note            String?    
  createdAt       DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedByUserId])
  @@map("order_status_history")
}

/// A discount the customer types in at checkout as a CODE. The client only ever
/// sends the code — the server resolves it and applies `calculateVoucherDiscount`
/// from @samou-go/shared-types, preserving the "client never sends money" rule.
model Voucher {
  id            String              @id @default(cuid())
  /// Case-insensitive match code, stored uppercase, e.g. `RAMADAN10`.
  code          String              @unique
  labelAr       String             
  labelEn       String             
  discountType  VoucherDiscountType @default(PERCENT)
  /// PERCENT → 0–100; FIXED → ILS amount off.
  discountValue Decimal            
  /// Ignored until the basket's subtotal reaches this, in ILS.
  minSubtotal   Decimal?           
  /// Hard cap on the savings (matters for PERCENT vouchers).
  maxDiscount   Decimal?           
  isActive      Boolean             @default(true)
  /// Optional dispatch window.
  startsAt      DateTime?
  expiresAt     DateTime?
  /// Global redemption cap; null = unlimited.
  usageLimit    Int?
  usedCount     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  orders Order[]

  @@index([code, isActive])
  @@map("vouchers")
}

/// A delivery fee zone configured by an admin (name + flat fee in ILS).
/// The captain picks the zone for an order — the fee is looked up HERE,
/// never typed or sent by the captain, so "client never sends money" holds.
model DeliveryZone {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  /// The full delivery fee for this zone, in ILS.
  fee       Decimal
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
  @@map("delivery_zones")
}

/// A store-scoped promotional announcement — «٢٠٪ خصم على المشروبات» shown as
/// marketing, NOT a redeemable code (that's `Voucher`). Managers create these
/// for their own store; customers browse them.
model Offer {
  id          String   @id @default(cuid())
  storeId     String
  titleAr     String
  titleEn     String
  descriptionAr String
  descriptionEn String
  /// Processed image served by the uploads pipeline (webp, immutable-cached).
  imageUrl    String?
  /// Storage key of the image object (never exposed over the API).
  imageKey    String?
  /// Optional dispatch window — only shown to customers while active.
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products OfferProduct[]

  @@index([storeId, isActive])
  @@index([isActive, expiresAt])
  @@map("offers")
}

/// Join table: an offer targets specific products (empty = store-wide).
model OfferProduct {
  id        String @id @default(cuid())
  offerId   String
  productId String

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([offerId, productId])
  @@index([productId])
  @@map("offer_products")
}

/// A customer's custom request (طلب مخصص): something the store doesn't list.
/// The customer describes what they want, the store replies with a price
/// (`PRICE_OFFERED`), and the customer accepts or rejects. Fulfilment is
/// manual — there is deliberately no delivery-flow coupling.
model CustomRequest {
  id          String   @id @default(cuid())
  customerId  String
  storeId     String
  /// What the customer wants, free text.
  description String
  /// Optional photo attached by the customer.
  imageUrl    String?
  status      CustomRequestStatus @default(PENDING)
  /// The store's quote in ILS — null until an offer is made.
  offeredPrice Decimal?
  /// The store manager's optional note alongside the quote.
  offerNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer User  @relation("CustomRequestCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, createdAt])
  @@index([customerId, status, createdAt])
  @@map("custom_requests")
}

/// A customer's saved store — the heart toggle on the home screen.
/// Free-text addresses already live on each order; favorites are store-level.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation("StoreFavorites", fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId, createdAt])
  @@map("favorites")
}

/// Per-day counter for human-facing order numbers (`SG-260808-0001`).
/// One row per calendar day; `sequence` is bumped ATOMICALLY inside the order
/// transaction (`upsert` + `increment`), so concurrent order creation can never
/// mint the same number — unlike a `COUNT(*)` race that the old code retried.
/// A rolled-back order rolls back its bump too, leaving (harmless) gaps.
model DailyOrderSequence {
  /// Local calendar day, stored as DATE (time-of-day is irrelevant).
  date     DateTime @id
  sequence Int      @default(0)

  @@map("daily_order_sequences")
}

model CaptainLocation {
  id String @id @default(cuid())
  captainId String @unique
  lat Float
  lng Float
  heading Float?
  updatedAt DateTime @updatedAt
  captain User @relation(fields: [captainId], references: [id], onDelete: Cascade)
  @@map("captain_locations")
}

model Rating {
  id String @id @default(cuid())
  orderId String @unique
  customerId String
  storeId String
  captainId String?
  storeRating Int
  captainRating Int?
  comment String?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User @relation("RatingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  captain User? @relation("RatingCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  @@index([storeId, createdAt])
  @@index([captainId, createdAt])
  @@map("ratings")
}

model ChatMessage {
  id String @id @default(cuid())
  orderId String
  senderId String
  senderRole UserRole
  message String
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@map("chat_messages")
}

model SupportTicket {
  id String @id @default(cuid())
  userId String
  role UserRole
  subject String
  description String
  status TicketStatus @default(OPEN)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@map("support_tickets")
}

model Wallet {
  id String @id @default(cuid())
  userId String? @unique
  storeId String? @unique
  balance Decimal @default(0)
  commissionRate Decimal @default(0.10)
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  settlements Settlement[]
  @@map("wallets")
}

model LedgerEntry {
  id String @id @default(cuid())
  walletId String
  userId String?
  amount Decimal
  type LedgerEntryType
  description String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([walletId, createdAt])
  @@map("ledger_entries")
}

model Settlement {
  id String @id @default(cuid())
  walletId String
  amount Decimal
  method SettlementMethod
  note String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([walletId, createdAt])
  @@map("settlements")
}

/// Singleton row (`id = 'platform'`) holding the platform-wide economy knobs.
model PlatformSettings {
  id String @id
  /// Flat captain payout per delivered order, on top of the delivery fee.
  captainDeliveryRate Decimal @default(0)
  /// Store commission rate applied to orders whose store wallet has no rate set.
  storeCommissionRate Decimal @default(0.10)
  /// Reserved for a future auto-assignment engine.
  autoAssign Boolean @default(false)
  /// When enabled, the driver sets the delivery fee per order upon acceptance.
  isDriverDynamicFeeEnabled Boolean @default(false)
  /// When enabled, admin-configured delivery zones are available for captain selection.
  /// When disabled (default), captains set the delivery fee manually.
  enableDeliveryZones Boolean @default(false)
  /// When enabled, sensitive actions (first order, password reset, phone change) require OTP verification.
  requireOtpForSensitiveActions Boolean @default(false)
  /// WhatsApp support phone number shown in the floating support button across all apps.
  whatsappSupportNumber String?
  updatedAt DateTime @updatedAt
  @@map("platform_settings")
}

/// FCM / APNs device token registered by a mobile client.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
