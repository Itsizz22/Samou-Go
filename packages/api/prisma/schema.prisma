// =============================================================================
// Samou' Go — PostgreSQL schema
// -----------------------------------------------------------------------------
// Hyper-local delivery for Samou', Hebron, Palestine.
//
// Two deliberate constraints shape this model:
//   1. Customer destinations are FREE TEXT. Samou' has no reliable street
//      numbering, so orders carry `customerAddressText` (neighbourhood /
//      landmark) and the captain phones the customer. GPS exists only on the
//      operational side: `Store.latitude/longitude` pin the shop and the
//      `CaptainLocation` model streams the assigned captain's live position
//      for order tracking — never on the customer address.
//   2. Money is Decimal(10,2), never Float. Prisma returns Decimal objects;
//      `src/modules/**/**.mapper.ts` converts them to numbers at the edge.
//
// Enum string values MUST stay byte-identical to packages/shared-types/src/enums.ts
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // Independent output so PostgreSQL codegen never overwrites the SQLite client
  // (which is generated into `../generated/prisma-sqlite`).
  output = "../generated/prisma-postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  CUSTOMER
  STORE_MANAGER
  CAPTAIN
  ADMIN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

/// Samou' is a cash economy; COD is the only live method.
/// Declared as an enum so adding card/wallet later is a migration, not a refactor.
enum PaymentMethod {
  COD
}

/// How a voucher's `discountValue` is interpreted.
enum VoucherDiscountType {
  PERCENT
  FIXED
}
enum TicketStatus {
  OPEN
  RESOLVED
}
enum SettlementMethod {
  CASH
  BANK_TRANSFER
}
enum LedgerEntryType {
  COMMISSION
  EARNING
  SETTLEMENT
}

// =============================================================================
// Models
// =============================================================================

/// One account, one role. Phone is the login identifier — Samou' users do not
/// reliably have email.
model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(120)
  /// Canonical Palestinian mobile: 10 digits, `05XXXXXXXX`.
  phone        String   @unique @db.VarChar(20)
  /// bcrypt hash. Never selected into an API response.
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  /// CAPTAIN accounts must be confirmed by an admin before they can take jobs.
  isVerified   Boolean  @default(false)
  /// CAPTAIN self-managed availability — must be on to claim orders.
  isAvailable  Boolean  @default(false)
  assignedStoreId String?
  /// Processed avatar URL served by the uploads pipeline (webp, immutable-cached).
  profileImageUrl String?
  /// Storage key of the avatar object (never exposed over the API).
  profileImageKey String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedStores  Store[]              @relation("StoreManager")
  customerOrders Order[]              @relation("OrderCustomer")
  captainOrders  Order[]              @relation("OrderCaptain")
  statusChanges  OrderStatusHistory[] @relation("StatusChangedBy")
  refreshTokens  RefreshToken[]
  favorites      Favorite[]           @relation("UserFavorites")
  assignedStore  Store?               @relation("DedicatedStoreCaptain", fields: [assignedStoreId], references: [id], onDelete: SetNull)
  captainLocation CaptainLocation?
  ratingsGiven Rating[] @relation("RatingCustomer")
  ratingsAsCaptain Rating[] @relation("RatingCaptain")
  chatMessages ChatMessage[]
  supportTickets SupportTicket[]
  wallet Wallet?
  ledgerEntries LedgerEntry[]

  @@index([role, isActive])
  @@index([assignedStoreId])
  @@map("users")
}

/// One active OTP per phone number (keyed by `phone`).
/// The code is bcrypt-hashed at rest and auto-expires in 3 minutes.
/// `requests`/`windowStartsAt` back the 3-per-5-minute request limiter so it
/// survives server restarts and does not depend on a single-node memory store.
model OtpRequest {
  phone          String   @id @db.VarChar(20)
  /// bcrypt hash of the 6-digit code. Never store the plaintext.
  codeHash       String
  expiresAt      DateTime
  /// Successful `code` attempts — wrong codes can only be tried a few times
  /// before the code is invalidated.
  attempts       Int      @default(0)
  /// OTP dispatch count inside the current rate-limit window.
  requests       Int      @default(1)
  /// Start of the 5-minute rate-limit window.
  windowStartsAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("otp_requests")
}

/// Long-lived session credential. Only the SHA-256 of the token is stored.
/// Refresh tokens rotate on use; an old token is revoked the moment its
/// replacement is minted, so replay of a stolen token fails.
model RefreshToken {
  id             String    @id @default(cuid())
  /// SHA-256 hex of the raw token. Never store the raw token.
  tokenHash      String    @unique
  userId         String
  expiresAt      DateTime
  /// Set when the token has been rotated or revoked.
  revokedAt      DateTime?
  /// The token that replaced this one (rotation lineage).
  replacedByHash String?   @unique
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// A shop in Samou'. `managerId` is the STORE_MANAGER who runs it; one manager
/// may run several shops.
model Store {
  id         String   @id @default(cuid())
  nameAr     String   @db.VarChar(160)
  nameEn     String   @db.VarChar(160)
  logoUrl    String?
  phone      String   @db.VarChar(20)
  isActive   Boolean  @default(true)
  /// New stores stay hidden from the public catalogue until an admin approves.
  isApproved Boolean  @default(false)
  managerId  String
  /// Shopfront GPS, when known — powers the captain's "navigate to store".
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  manager    User       @relation("StoreManager", fields: [managerId], references: [id], onDelete: Restrict)
  categories Category[]
  products   Product[]
  orders     Order[]
  favorites  Favorite[] @relation("StoreFavorites")
  dedicatedCaptains User[] @relation("DedicatedStoreCaptain")
  ratings Rating[]
  wallet Wallet?

  @@index([managerId])
  @@index([isActive])
  @@index([nameAr])
  @@map("stores")
}

/// A menu section, scoped to one store. Two stores may both have "┘à╪┤╪▒┘ê╪¿╪º╪¬".
model Category {
  id        String   @id @default(cuid())
  nameAr    String   @db.VarChar(120)
  nameEn    String   @db.VarChar(120)
  storeId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, nameEn])
  @@index([storeId, sortOrder])
  @@map("categories")
}

/// A sellable item. `price` is the *current* price; an order captures its own
/// `unitPrice` so repricing never rewrites history.
model Product {
  id          String   @id @default(cuid())
  nameAr      String   @db.VarChar(160)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  categoryId  String?
  storeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([storeId, isAvailable])
  @@index([categoryId])
  @@index([nameAr])
  @@map("products")
}

/// A basket that has been committed. Financials are written by the server only —
/// `deliveryFee` always comes from `calculateDeliveryFee(itemCount)` in
/// @samou-go/shared-types, never from the client.
model Order {
  id          String @id @default(cuid())
  /// Human-facing reference shown to the customer: `SG-260728-0042`.
  orderNumber String @unique @db.VarChar(24)

  customerId String
  storeId    String
  /// Null until an admin or the captain themselves takes the job.
  captainId  String?

  status OrderStatus @default(PENDING)

  /// Free-text destination: neighbourhood, street, landmark. No GPS by design.
  customerAddressText String  @db.VarChar(500)
  /// Optional extra directions, e.g. "╪¿╪¼╪º┘å╪¿ ┘à╪│╪¼╪» ╪╣┘à╪▒╪î ╪º┘ä╪╖╪º╪¿┘é ╪º┘ä╪½╪º┘å┘è".
  addressNote         String? @db.VarChar(500)
  orderNote           String? @db.VarChar(500)
  estimatedPrepMinutes Int?

  subtotal      Decimal       @db.Decimal(10, 2)
  deliveryFee   Decimal       @db.Decimal(10, 2)
  /// Voucher savings, in ILS — 0 when no voucher was applied.
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(COD)
  voucherId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User                 @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  store         Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  captain       User?                @relation("OrderCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  voucher       Voucher?             @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  rating Rating?
  chatMessages ChatMessage[]

  @@index([customerId, createdAt])
  @@index([storeId, status])
  @@index([captainId, status])
  @@index([status, createdAt])
  @@map("orders")
}

/// One basket line. `unitPrice` and `totalPrice` are frozen at order time.
model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  note       String? @db.VarChar(500)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// One row per product per order — quantity carries the count.
  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

/// Append-only audit trail. This is what the Live Order Tracking screen renders
/// as a timeline, and what settles "who cancelled my order?" disputes.
model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  /// Null for system-driven transitions (e.g. auto-expiry jobs).
  changedByUserId String?
  note            String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedByUserId])
  @@map("order_status_history")
}

/// A discount the customer types in at checkout as a CODE. The client only ever
/// sends the code — the server resolves it and applies `calculateVoucherDiscount`
/// from @samou-go/shared-types, preserving the "client never sends money" rule.
model Voucher {
  id            String              @id @default(cuid())
  /// Case-insensitive match code, stored uppercase, e.g. `RAMADAN10`.
  code          String              @unique @db.VarChar(40)
  labelAr       String              @db.VarChar(160)
  labelEn       String              @db.VarChar(160)
  discountType  VoucherDiscountType @default(PERCENT)
  /// PERCENT ΓåÆ 0ΓÇô100; FIXED ΓåÆ ILS amount off.
  discountValue Decimal             @db.Decimal(10, 2)
  /// Ignored until the basket's subtotal reaches this, in ILS.
  minSubtotal   Decimal?            @db.Decimal(10, 2)
  /// Hard cap on the savings (matters for PERCENT vouchers).
  maxDiscount   Decimal?            @db.Decimal(10, 2)
  isActive      Boolean             @default(true)
  /// Optional dispatch window.
  startsAt      DateTime?
  expiresAt     DateTime?
  /// Global redemption cap; null = unlimited.
  usageLimit    Int?
  usedCount     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  orders Order[]

  @@index([code, isActive])
  @@map("vouchers")
}

/// A customer's saved store — the heart toggle on the home screen.
/// Free-text addresses already live on each order; favorites are store-level.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation("StoreFavorites", fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId, createdAt])
  @@map("favorites")
}

/// Per-day counter for human-facing order numbers (`SG-260808-0001`).
/// One row per calendar day; `sequence` is bumped ATOMICALLY inside the order
/// transaction (`upsert` + `increment`), so concurrent order creation can never
/// mint the same number — unlike a `COUNT(*)` race that the old code retried.
/// A rolled-back order rolls back its bump too, leaving (harmless) gaps.
model DailyOrderSequence {
  /// Local calendar day, stored as DATE (time-of-day is irrelevant).
  date     DateTime @id @db.Date
  sequence Int      @default(0)

  @@map("daily_order_sequences")
}
model CaptainLocation {
  id String @id @default(cuid())
  captainId String @unique
  lat Float
  lng Float
  heading Float?
  updatedAt DateTime @updatedAt
  captain User @relation(fields: [captainId], references: [id], onDelete: Cascade)
  @@map("captain_locations")
}
model Rating {
  id String @id @default(cuid())
  orderId String @unique
  customerId String
  storeId String
  captainId String?
  storeRating Int
  captainRating Int?
  comment String?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User @relation("RatingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  captain User? @relation("RatingCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  @@index([storeId, createdAt])
  @@index([captainId, createdAt])
  @@map("ratings")
}
model ChatMessage {
  id String @id @default(cuid())
  orderId String
  senderId String
  senderRole UserRole
  message String
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@map("chat_messages")
}
model SupportTicket {
  id String @id @default(cuid())
  userId String
  role UserRole
  subject String
  description String
  status TicketStatus @default(OPEN)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@map("support_tickets")
}
model Wallet {
  id String @id @default(cuid())
  userId String? @unique
  storeId String? @unique
  balance Decimal @default(0) @db.Decimal(10, 2)
  commissionRate Decimal @default(0.10) @db.Decimal(5, 4)
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  settlements Settlement[]
  @@map("wallets")
}
model LedgerEntry {
  id String @id @default(cuid())
  walletId String
  userId String?
  amount Decimal @db.Decimal(10, 2)
  type LedgerEntryType
  description String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([walletId, createdAt])
  @@map("ledger_entries")
}
model Settlement {
  id String @id @default(cuid())
  walletId String
  amount Decimal @db.Decimal(10, 2)
  method SettlementMethod
  note String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([walletId, createdAt])
  @@map("settlements")
}
