{
  "name": "@samou-go/api",
  "version": "0.1.0",
  "private": true,
  "description": "Samou' Go — Express + Prisma backend",
  "license": "UNLICENSED",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:generate:prod": "prisma generate --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=prisma/schema.sqlite.prisma",
    "prisma:validate:prod": "prisma validate --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.sqlite.prisma",
    "prisma:seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "prisma": {
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@samou-go/shared-types": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.10"
  }
}
