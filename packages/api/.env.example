# ==============================================================================
# Samou' Go — API environment
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ==============================================================================

# --- Database -----------------------------------------------------------------
# Dual-schema setup:
#   • LOCAL dev/test  → SQLite (prisma/schema.sqlite.prisma → file:./dev.db).
#       Managed with `npm run db:generate && npm run db:push && npm run db:seed`.
#       Local SQLite runs never read this variable. The placeholder below only
#       exists so `npm install`'s Prisma postinstall (which generates from the
#       PRODUCTION schema) and any prod-schema validate/generate succeed — those
#       commands never connect to a database. NEVER put a real credential here.
#   • PRODUCTION      → PostgreSQL (prisma/schema.prisma).
#       DATABASE_URL is injected as a deployment secret (e.g. Neon) by the host,
#       and the DB is migrated with `npm run db:deploy` (prisma migrate deploy).
#       See the production guard in src/config/env.ts.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samou_go?schema=public"

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Auth ---------------------------------------------------------------------
# Generate a real one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-at-least-32-characters-of-random"
# Access token lifetime (legacy name; still honoured when JWT_ACCESS_EXPIRES_IN is unset).
JWT_EXPIRES_IN=7d
# Short-lived access token for production — the client refreshes silently.
# JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime. Rotated on every use; only a SHA-256 is stored.
JWT_REFRESH_EXPIRES_IN=30d

# --- SMS / OTP ----------------------------------------------------------------
# Provider: twilio | generic | console | mock | none
#   console — logs the code to the server console (development only)
#   none    — accepts without dispatching (tests)
SMS_PROVIDER=console
# Twilio (SMS_PROVIDER=twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Twilio Verify (optional — when set, codes are dispatched via the Twilio Verify
# API which handles code lifecycle. When absent, raw SMS via Messages API is used
# and the server generates/stores the OTP code itself):
# TWILIO_VERIFY_SERVICE_SID=
# Generic HTTPS gateway (SMS_PROVIDER=generic):
# SMS_GENERIC_ENDPOINT=
# SMS_GENERIC_API_KEY=
# SMS_GENERIC_SENDER=
# OTP behaviour — see requirements: 3 requests / 5 min per phone, 3 min expiry.
# OTP_LENGTH=6
# OTP_TTL_SECONDS=180
# OTP_RATE_MAX=3
# OTP_RATE_WINDOW_MINUTES=5
# OTP_MAX_ATTEMPTS=5

# --- CORS ---------------------------------------------------------------------
# EXTRA origins only. `src/config/cors.ts` already allows, with no config:
#   • the 7 Vercel production SPAs (https://samou-go-<app>.vercel.app)
#   • every https://*.vercel.app preview deployment
#   • the 7 Vite dev servers (http://localhost:5173–5179)
# So this variable is for what the code cannot know: LAN IPs, ngrok hosts, the
# Capacitor Android WebView origin, a future custom domain. `*` disables the
# check entirely.
#
# On Android the app is served from `https://localhost` (default androidScheme),
# so the API must accept that origin or every fetch from the APK is rejected.
#
# Cellular / tunnel testing: when a phone reaches the API through ngrok, the
# browser (WebView) origin is the Vite dev origin (e.g. http://192.168.0.100:5173)
# but the request goes out over the tunnel — so CORS still compares against the
# WEB origin listed above, NOT the ngrok host. If instead you deploy the frontend
# and phone it on cellular, add that deployed origin here too. The free ngrok URL
# rotates per session; a paid static domain or a Render deploy removes the churn.
CORS_ORIGINS="https://localhost,http://192.168.0.100:5173,http://192.168.0.100:5174,http://192.168.0.100:5175,http://192.168.0.100:5176"

# --- Uploads ------------------------------------------------------------------
# Local-disk directory for uploaded images (raw + processed objects).
UPLOAD_DIR=.uploads
# Hard ceiling for a single uploaded file, in bytes (default 8 MB).
# UPLOAD_MAX_BYTES=8388608
# Public base URL the API is reachable at — prefix for absolute image URLs.
# Required in production (must be https). The production guard rejects http://.
# PUBLIC_API_ORIGIN=https://samou-go-api.onrender.com

# --- Delivery tariff ----------------------------------------------------------
# DELIVERY IS FREE platform-wide (2026-08): the API hard-zeros the fee, so these
# overrides are currently DORMANT. Keep them for the day a fee re-launches.
DELIVERY_BASE_FEE=0
DELIVERY_BULK_FEE=0
DELIVERY_BULK_THRESHOLD=5
