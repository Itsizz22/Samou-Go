# ==============================================================================
# Samou' Go — API environment
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ==============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# Local: createdb samou_go && set the password below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samou_go?schema=public"

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Auth ---------------------------------------------------------------------
# Generate a real one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-at-least-32-characters-of-random"
JWT_EXPIRES_IN=7d

# --- CORS ---------------------------------------------------------------------
# Comma-separated origins. These are the seven Vite dev servers.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179"

# --- Delivery tariff ----------------------------------------------------------
# Overrides the defaults in @samou-go/shared-types. Fees are in ILS (₪).
DELIVERY_BASE_FEE=3
DELIVERY_BULK_FEE=5
DELIVERY_BULK_THRESHOLD=5
