# ==============================================================================
# Samou' Go — API environment
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ==============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# Local: createdb samou_go && set the password below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samou_go?schema=public"

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Auth ---------------------------------------------------------------------
# Generate a real one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-at-least-32-characters-of-random"
# Access token lifetime (legacy name; still honoured when JWT_ACCESS_EXPIRES_IN is unset).
JWT_EXPIRES_IN=7d
# Short-lived access token for production — the client refreshes silently.
# JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime. Rotated on every use; only a SHA-256 is stored.
JWT_REFRESH_EXPIRES_IN=30d

# --- SMS / OTP ----------------------------------------------------------------
# Provider: twilio | firebase | generic | console | none
#   console — logs the code to the server console (development only)
#   none    — accepts without dispatching (tests)
SMS_PROVIDER=console
# Twilio (SMS_PROVIDER=twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Firebase Cloud Function (SMS_PROVIDER=firebase):
# FIREBASE_SMS_FUNCTION_URL=
# FIREBASE_SMS_API_KEY=
# Generic HTTPS gateway (SMS_PROVIDER=generic):
# SMS_GENERIC_ENDPOINT=
# SMS_GENERIC_API_KEY=
# SMS_GENERIC_SENDER=
# OTP behaviour — see requirements: 3 requests / 5 min per phone, 3 min expiry.
# OTP_LENGTH=6
# OTP_TTL_SECONDS=180
# OTP_RATE_MAX=3
# OTP_RATE_WINDOW_MINUTES=5
# OTP_MAX_ATTEMPTS=5

# --- CORS ---------------------------------------------------------------------
# Comma-separated origins: the seven Vite dev servers, plus the Capacitor
# Android WebView origins. On Android the app is served from `https://localhost`
# (default androidScheme), so the API must accept that origin or every fetch
# from the APK is rejected. Add your LAN IP for device testing.
#
# Cellular / tunnel testing: when a phone reaches the API through ngrok, the
# browser (WebView) origin is the Vite dev origin (e.g. http://192.168.0.111:5173)
# but the request goes out over the tunnel — so CORS still compares against the
# WEB origin listed above, NOT the ngrok host. If instead you deploy the frontend
# and phone it on cellular, add that deployed origin here too. The free ngrok URL
# rotates per session; a paid static domain or a Render deploy removes the churn.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179,https://localhost,http://192.168.0.111:5173,http://192.168.0.111:5174,http://192.168.0.111:5175,http://192.168.0.111:5176"

# --- Delivery tariff ----------------------------------------------------------
# Overrides the defaults in @samou-go/shared-types. Fees are in ILS (₪).
DELIVERY_BASE_FEE=3
DELIVERY_BULK_FEE=5
DELIVERY_BULK_THRESHOLD=5
