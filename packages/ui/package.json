{
  "name": "@samou-go/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./styles": "./src/styles/design-system.css",
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@samou-go/shared-types": "*",
    "clsx": "^2.1.1",
    "mapbox-gl": "3.30.0",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "framer-motion": ">=11",
    "lucide-react": ">=0.4.0",
    "react": ">=18"
  },
  "devDependencies": {
    "typescript": "~5.7.2"
  }
}
