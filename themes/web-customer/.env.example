# =============================================================================
# Samou' Go — API endpoint selection
# =============================================================================

# Resolution order (see packages/api-client/src/api.ts):
#   1. VITE_API_BASE_URL        (base host; /api/v1 appended if missing)
#   2. VITE_API_URL             (legacy: full URL, verbatim)
#   3. LAN fallback             http://192.168.0.100:4000 (built-in, no .env needed)
# On boot the client logs which one it picked, e.g.:
#   [api-client] API base URL — VITE_API_BASE_URL: https://abcd-12-34-56-78.ngrok-free.app/api/v1
#
# Only set ONE of the two variables per environment. Pick your scenario below.
# =============================================================================

# --- Case 1: LAN dev (phone on the same Wi-Fi as this machine) --------------
# No .env needed at all — the built-in fallback IS the LAN IP. Set explicitly
# only if your dev machine's IP differs from 192.168.0.100:
# VITE_API_BASE_URL=http://192.168.0.100:4000

# --- Case 2: ngrok tunnel (phone on cellular, API still running locally) ----
# Start the tunnel, then copy the https URL from the ngrok console. Requires the
# same origin in packages/api/.env CORS_ORIGINS (see note at the bottom).
# VITE_API_BASE_URL=https://abcd-12-34-56-78.ngrok-free.app

# --- Case 3: deployed API (Render / Neon or equivalent) ---------------------
# Point at the deployed backend. Same as Case 2 — no cleartext,
# no tunnel, and the phone reaches it over any network.
# VITE_API_BASE_URL=https://samougo-api.onrender.com

# Legacy full-URL form (rarely needed — prefer VITE_API_BASE_URL):
# VITE_API_URL=<full-api-origin>/api/v1

# =============================================================================
# ngrok free-tier note
# =============================================================================
# The free ngrok URL rotates every session, so on each restart you must:
#   1. Re-point VITE_API_BASE_URL above at the new tunnel URL.
#   2. Re-add that origin to CORS_ORIGINS in packages/api/.env and restart the API.
#   3. Rebuild the web app and `npx cap sync android`.
# A paid static ngrok domain (ngrok.com, ~$8/mo) or a free Render deployment
# (render.com) of the API removes this churn entirely.
# =============================================================================
