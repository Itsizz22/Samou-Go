    "@samou-go/shared-types": "0.1.0",
    "@samou-go/ui": "0.1.0",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "framer-motion": "^12.4.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
