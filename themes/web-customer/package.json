    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "3.5.3",
    "tailwindcss": "^4.0.9",
    "tw-animate-css": "^1.3.7",
    "typescript": "~5.7.2",
