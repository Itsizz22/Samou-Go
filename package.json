{
  "name": "samou-go",
  "version": "0.1.0",
  "private": true,
  "description": "Samou' Go — hyper-local delivery platform for Samou', Hebron, Palestine",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "themes/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepare": "npm run build --workspace @samou-go/shared-types && npm run build --workspace @samou-go/ui",
    "build": "tsc -b packages/shared-types packages/ui packages/api",
    "build:all": "npm run build && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:all": "npm run typecheck && tsc -b packages/shared-types packages/ui packages/api",
    "typecheck:server": "tsc -b packages/shared-types packages/api --force",
    "typecheck:web-customer": "npm run typecheck --workspace @samou-go/web-customer",
    "typecheck:web-store-details": "npm run typecheck --workspace @samou-go/web-store-details",
    "typecheck:web-checkout": "npm run typecheck --workspace @samou-go/web-checkout",
    "typecheck:web-order-tracking": "npm run typecheck --workspace @samou-go/web-order-tracking",
    "typecheck:web-store-manager": "npm run typecheck --workspace @samou-go/web-store-manager",
    "typecheck:web-captain": "npm run typecheck --workspace @samou-go/web-captain",
    "typecheck:web-admin": "npm run typecheck --workspace @samou-go/web-admin",
    "clean": "tsc -b packages/shared-types packages/ui packages/api --clean",
    "dev:api": "npm run dev --workspace @samou-go/api",
    "dev:web-customer": "npm run dev --workspace @samou-go/web-customer",
    "dev:web-store-details": "npm run dev --workspace @samou-go/web-store-details",
    "dev:web-checkout": "npm run dev --workspace @samou-go/web-checkout",
    "dev:web-order-tracking": "npm run dev --workspace @samou-go/web-order-tracking",
    "dev:web-store-manager": "npm run dev --workspace @samou-go/web-store-manager",
    "dev:web-captain": "npm run dev --workspace @samou-go/web-captain",
    "dev:web-admin": "npm run dev --workspace @samou-go/web-admin",
    "db:generate": "npm run prisma:generate --workspace @samou-go/api",
    "db:generate:prod": "npm run prisma:generate:prod --workspace @samou-go/api",
    "db:validate": "npm run prisma:validate --workspace @samou-go/api",
    "db:validate:prod": "npm run prisma:validate:prod --workspace @samou-go/api",
    "db:deploy": "npm run prisma:deploy --workspace @samou-go/api",
    "db:push": "npm run prisma:push --workspace @samou-go/api",
    "db:studio": "npm run prisma:studio --workspace @samou-go/api",
    "db:seed": "npm run prisma:seed --workspace @samou-go/api",
    "db:admin-password": "npm run admin:password --workspace @samou-go/api",
    "test:e2e": "npm run test:e2e --workspace @samou-go/api",
    "test": "npm run test --workspace @samou-go/shared-types"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "~5.7.2"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "lucide-react": "^1.31.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.5": true
  }
}
