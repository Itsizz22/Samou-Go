# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
build/
*.tsbuildinfo
packages/*/dist/
themes/*/dist/

# capacitor native project (regenerable via `npx cap add|sync android`)
themes/*/android/

# environment — never commit real secrets
.env
.env.*
!.env.example

# prisma
packages/api/prisma/migrations/dev.db*
packages/api/prisma/*.db
# generated Prisma clients (regenerable via db:generate / db:generate:prod)
packages/api/generated/

# uploaded images (local storage driver scratch + processed files)
packages/api/.uploads/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / OS
.DS_Store
Thumbs.db
*.swp

# test / coverage
coverage/
.nyc_output/

# vite / tooling caches
.vite/
node_modules/.tmp/
.eslintcache

# one-off browser-audit artifacts (regenerable, never commit)
.browser-audit-profile/
browser-audit-final.mjs
browser-audit-results.json
