# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
build/
*.tsbuildinfo
packages/*/dist/
themes/*/dist/

# capacitor native project (regenerable via `npx cap add|sync android`)
themes/*/android/

# environment — never commit real secrets
.env
.env.*
!.env.example

# Firebase Admin service account (private key) — never commit
firebase-service-account.json
packages/api/firebase-service-account.json

# prisma
packages/api/prisma/migrations/dev.db*
packages/api/prisma/*.db
# generated Prisma clients (regenerable via db:generate / db:generate:prod)
packages/api/generated/

# uploaded images (local storage driver scratch + processed files)
packages/api/.uploads/
# legacy root uploads dir from when the API ran at the repo root — never track
.uploads/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# test / coverage
coverage/
.nyc_output/

# vite / tooling caches
.vite/
node_modules/.tmp/
.eslintcache

# one-off browser-audit artifacts (regenerable, never commit)
.browser-audit-profile/
browser-audit-final.mjs
browser-audit-results.json
